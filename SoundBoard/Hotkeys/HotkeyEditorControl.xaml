<!-- Keyboard capture plus explicit side-button controls: no simulated mouse input needed. -->
<UserControl x:Class="SoundBoard.HotkeyEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="UserControl">
    <StackPanel>
        <TextBox x:Name="HotkeyTextBox" MinHeight="30"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                 PreviewMouseDown="HotkeyTextBox_PreviewMouseDown"
                 ToolTip="Focus here and press a key or Mouse4/Mouse5. Escape, Delete or Backspace clears."
                 Text="{Binding Hotkey, ElementName=UserControl, Mode=OneWay, TargetNullValue=&lt; not set &gt;}">
            <TextBox.ContextMenu><ContextMenu Visibility="Collapsed" /></TextBox.ContextMenu>
        </TextBox>
        <WrapPanel Margin="0,5,0,0" HorizontalAlignment="Center">
            <Button Content="Mouse4" AutomationProperties.AutomationId="SelectMouse4" Click="Mouse4_Click" Padding="6,3" ToolTip="XButton1 (no mouse-button press sent)" />
            <Button Content="Mouse5" AutomationProperties.AutomationId="SelectMouse5" Click="Mouse5_Click" Padding="6,3" Margin="4,0" ToolTip="XButton2 (no mouse-button press sent)" />
            <Button Content="Clear" Click="Clear_Click" Padding="6,3" />
        </WrapPanel>
        <WrapPanel Margin="0,5,0,0" HorizontalAlignment="Center">
            <CheckBox x:Name="CtrlModifier" Content="Ctrl" Margin="0,0,6,0" Click="Modifier_Click" />
            <CheckBox x:Name="ShiftModifier" Content="Shift" Margin="0,0,6,0" Click="Modifier_Click" />
            <CheckBox x:Name="AltModifier" Content="Alt" Margin="0,0,6,0" Click="Modifier_Click" />
            <CheckBox x:Name="WinModifier" Content="Win" Click="Modifier_Click" />
        </WrapPanel>
    </StackPanel>
</UserControl>
