<!-- Keyboard capture plus explicit side-button controls: no simulated mouse input needed. -->
<UserControl x:Class="SoundBoard.HotkeyEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="UserControl">
    <StackPanel>
        <TextBox x:Name="HotkeyTextBox" MinHeight="30"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                 PreviewMouseDown="HotkeyTextBox_PreviewMouseDown"
                 ToolTip="Focus here and press a key or Mouse4/Mouse5. Escape, Delete or Backspace clears."
                 Text="{Binding Hotkey.DisplayText, ElementName=UserControl, Mode=OneWay, TargetNullValue=&lt; not set &gt;}">
            <TextBox.ContextMenu><ContextMenu Visibility="Collapsed" /></TextBox.ContextMenu>
        </TextBox>
        <TextBlock Text="Top row — no modifiers" FontSize="11" Margin="0,5,0,2" />
        <UniformGrid Rows="1" Columns="10">
            <Button Content="1" Tag="1" Click="Number_Click" Padding="0,3" ToolTip="Top-row 1 alone (no Ctrl or numpad)" />
            <Button Content="2" Tag="2" Click="Number_Click" Padding="0,3" ToolTip="Top-row 2 alone (no Ctrl or numpad)" />
            <Button Content="3" Tag="3" Click="Number_Click" Padding="0,3" ToolTip="Top-row 3 alone (no Ctrl or numpad)" />
            <Button Content="4" Tag="4" Click="Number_Click" Padding="0,3" ToolTip="Top-row 4 alone (no Ctrl or numpad)" />
            <Button Content="5" Tag="5" Click="Number_Click" Padding="0,3" ToolTip="Top-row 5 alone (no Ctrl or numpad)" />
            <Button Content="6" Tag="6" Click="Number_Click" Padding="0,3" ToolTip="Top-row 6 alone (no Ctrl or numpad)" />
            <Button Content="7" Tag="7" Click="Number_Click" Padding="0,3" ToolTip="Top-row 7 alone (no Ctrl or numpad)" />
            <Button Content="8" Tag="8" Click="Number_Click" Padding="0,3" ToolTip="Top-row 8 alone (no Ctrl or numpad)" />
            <Button Content="9" Tag="9" Click="Number_Click" Padding="0,3" ToolTip="Top-row 9 alone (no Ctrl or numpad)" />
            <Button Content="0" Tag="0" Click="Number_Click" Padding="0,3" ToolTip="Top-row 0 alone (no Ctrl or numpad)" />
        </UniformGrid>
        <WrapPanel Margin="0,5,0,0" HorizontalAlignment="Center">
            <Button Content="Mouse4" AutomationProperties.AutomationId="SelectMouse4" Click="Mouse4_Click" Padding="6,3" ToolTip="XButton1 (no mouse-button press sent)" />
            <Button Content="Mouse5" AutomationProperties.AutomationId="SelectMouse5" Click="Mouse5_Click" Padding="6,3" Margin="4,0" ToolTip="XButton2 (no mouse-button press sent)" />
            <Button Content="Clear" Click="Clear_Click" Padding="6,3" />
        </WrapPanel>
        <WrapPanel Margin="0,5,0,0" HorizontalAlignment="Center">
            <CheckBox x:Name="CtrlModifier" Content="Ctrl" Margin="0,0,6,0" Click="Modifier_Click" />
            <CheckBox x:Name="ShiftModifier" Content="Shift" Margin="0,0,6,0" Click="Modifier_Click" />
            <CheckBox x:Name="AltModifier" Content="Alt" Margin="0,0,6,0" Click="Modifier_Click" />
            <CheckBox x:Name="WinModifier" Content="Win" Click="Modifier_Click" />
        </WrapPanel>
    </StackPanel>
</UserControl>
